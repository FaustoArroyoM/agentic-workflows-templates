<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_bringup</name>
  <version>0.1.0</version>
  <description>Launch files that start the whole robot with one command.</description>
  <maintainer email="fausto.arroyo.mantero@gmail.com">robot-team</maintainer>
  <license>MIT</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- the packages this launch file starts (add yours here as they appear) -->
  <exec_depend>example_py_pkg</exec_depend>
  <exec_depend>example_cpp_pkg</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
