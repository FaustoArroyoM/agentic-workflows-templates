<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>example_cpp_pkg</name>
  <version>0.1.0</version>
  <description>EXAMPLE C++ (ament_cmake) package — copy this to start your own.</description>
  <maintainer email="fausto.arroyo.mantero@gmail.com">robot-team</maintainer>
  <license>MIT</license>

  <!-- C++ packages are built with ament_cmake instead of ament_python -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- <depend> = needed at BOTH build time and run time (typical for C++) -->
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
