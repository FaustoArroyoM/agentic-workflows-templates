<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>example_c_pkg</name>
  <version>0.0.1</version>
  <description>Example C node using rclc (the official ROS2 C client library).</description>
  <maintainer email="todo@todo.com">todo</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- rclc = ROS2 C client library. rosdep installs ros-humble-rclc automatically. -->
  <depend>rcl</depend>
  <depend>rclc</depend>
  <depend>std_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
